const PEDIDOS = 'PEDIDOS_MOSTRADOR';
const HISTORIAL = 'HISTORIAL_OPERACIONES';
const TZ = 'America/Argentina/Buenos_Aires';
const HEADERS = ['ID','NUMERO_ORDEN','NOMBRE','APELLIDO','RESUMEN','IMPORTE','OBSERVACIONES','ESTADO','CREADO_POR','FECHA_CREACION','HORA_CREACION','MODIFICADO_POR','FECHA_MODIFICACION','HORA_MODIFICACION','COBRADO_POR','FECHA_COBRO','HORA_COBRO'];
const AUDIT_HEADERS = ['ID_OPERACION','ID_PEDIDO','NUMERO_ORDEN','ACCION','USUARIO','FECHA','HORA'];

function doGet(e) { return route_(e.parameter.action || 'getPedidos', {}); }
function doPost(e) { const body = JSON.parse(e.postData.contents || '{}'); return route_(body.action || e.parameter.action, body); }
function configurarHojas() { setup_(); }
function route_(action, body) { try { setup_(); let data; if (action === 'getPedidos') data = getPedidos_(); else if (action === 'getHistorial') data = getPedidos_().filter(p => p.estado === 'COBRADO'); else if (action === 'crearPedido') data = crear_(body); else if (action === 'actualizarPedido') data = actualizar_(body); else if (action === 'cobrarPedido') data = cobrar_(body); else throw new Error('Acción no válida.'); return json_({ok:true,data:data}); } catch(err) { return json_({ok:false,error:String(err.message || err)}); } }
function setup_(){ const ss=SpreadsheetApp.getActive(); let p=ss.getSheetByName(PEDIDOS); if(!p){p=ss.insertSheet(PEDIDOS);p.appendRow(HEADERS);} let h=ss.getSheetByName(HISTORIAL);if(!h){h=ss.insertSheet(HISTORIAL);h.appendRow(AUDIT_HEADERS);} }
function getPedidos_(){const s=SpreadsheetApp.getActive().getSheetByName(PEDIDOS);if(s.getLastRow()<2)return[];return s.getRange(2,1,s.getLastRow()-1,HEADERS.length).getValues().filter(r=>r[0]).map(rowToPedido_);}
function crear_(b){const p=b.pedido;if(!p.numeroOrden||!p.nombre||!p.apellido||Number(p.importe)<=0)throw new Error('Faltan campos obligatorios.');if(getPedidos_().some(x=>String(x.numeroOrden).toLowerCase()===String(p.numeroOrden).toLowerCase()))throw new Error('La orden #'+p.numeroOrden+' ya existe.');const d=stamp_();const id=Utilities.getUuid();SpreadsheetApp.getActive().getSheetByName(PEDIDOS).appendRow([id,p.numeroOrden,p.nombre,p.apellido,p.resumen||'',Number(p.importe),p.observaciones||'','PENDIENTE',b.puesto,d.fecha,d.hora,'','','','','','']);audit_(id,p.numeroOrden,'CREACION',b.puesto,d);return{id:id};}
function actualizar_(b){const found=find_(b.id);const p=b.pedido;const d=stamp_();const old=found.values;found.sheet.getRange(found.row,1,1,HEADERS.length).setValues([[old[0],p.numeroOrden,p.nombre,p.apellido,p.resumen||'',Number(p.importe),p.observaciones||'',old[7],old[8],old[9],old[10],b.puesto,d.fecha,d.hora,old[14],old[15],old[16]]]);audit_(b.id,p.numeroOrden,'EDICION',b.puesto,d);return{id:b.id};}
function cobrar_(b){const found=find_(b.id);const d=stamp_();found.sheet.getRange(found.row,8).setValue('COBRADO');found.sheet.getRange(found.row,15,1,3).setValues([[b.puesto,d.fecha,d.hora]]);audit_(b.id,found.values[1],'COBRO',b.puesto,d);return{id:b.id};}
function find_(id){const s=SpreadsheetApp.getActive().getSheetByName(PEDIDOS);const v=s.getDataRange().getValues();for(let i=1;i<v.length;i++)if(String(v[i][0])===String(id))return{sheet:s,row:i+1,values:v[i]};throw new Error('Pedido no encontrado.');}
function audit_(id,orden,accion,usuario,d){SpreadsheetApp.getActive().getSheetByName(HISTORIAL).appendRow([Utilities.getUuid(),id,orden,accion,usuario,d.fecha,d.hora]);}
function stamp_(){const n=new Date();return{fecha:Utilities.formatDate(n,TZ,'dd/MM/yyyy'),hora:Utilities.formatDate(n,TZ,'HH:mm'),iso:n.toISOString()};}
function rowToPedido_(r){const isoFrom=(f,h)=>{if(!f)return'';if(Object.prototype.toString.call(f)==='[object Date]')return f.toISOString();const x=String(f).split('/');return x.length===3?new Date(x[2]+'-'+x[1]+'-'+x[0]+'T'+(h||'00:00')+':00-03:00').toISOString():String(f)};return{id:String(r[0]),numeroOrden:String(r[1]),nombre:String(r[2]),apellido:String(r[3]),resumen:String(r[4]||''),importe:Number(r[5]),observaciones:String(r[6]||''),estado:String(r[7]),creadoPor:String(r[8]),creadoEn:isoFrom(r[9],r[10]),modificadoPor:String(r[11]||''),modificadoEn:isoFrom(r[12],r[13]),cobradoPor:String(r[14]||''),cobradoEn:isoFrom(r[15],r[16])};}
function json_(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);}
