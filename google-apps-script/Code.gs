const PEDIDOS = 'PEDIDOS_MOSTRADOR';
const HISTORIAL = 'HISTORIAL_OPERACIONES';
const TZ = 'America/Argentina/Buenos_Aires';
const HEADERS = ['ID','NUMERO_ORDEN','NOMBRE','APELLIDO','RESUMEN','IMPORTE','OBSERVACIONES','ESTADO','CREADO_POR','FECHA_CREACION','HORA_CREACION','MODIFICADO_POR','FECHA_MODIFICACION','HORA_MODIFICACION','COBRADO_POR','FECHA_COBRO','HORA_COBRO'];
const AUDIT_HEADERS = ['ID_OPERACION','ID_PEDIDO','NUMERO_ORDEN','ACCION','USUARIO','FECHA','HORA'];
function doGet(e){return route_(e.parameter.action||'getPedidos',{});} function doPost(e){const b=JSON.parse(e.postData.contents||'{}');return route_(b.action||e.parameter.action,b);} function configurarHojas(){setup_();}
function route_(a,b){try{setup_();let d;if(a==='getPedidos')d=getPedidos_();else if(a==='getHistorial')d=getPedidos_().filter(p=>p.estado==='COBRADO');else if(a==='crearPedido')d=crear_(b);else if(a==='actualizarPedido')d=actualizar_(b);else if(a==='cobrarPedido')d=cobrar_(b);else if(a==='borrarHistorial')d=borrarHistorial_(b);else throw new Error('Acción no válida.');return json_({ok:true,data:d});}catch(err){return json_({ok:false,error:String(err.message||err)});}}
function setup_(){const ss=SpreadsheetApp.getActive();let p=ss.getSheetByName(PEDIDOS);if(!p){p=ss.insertSheet(PEDIDOS);p.appendRow(HEADERS);}let h=ss.getSheetByName(HISTORIAL);if(!h){h=ss.insertSheet(HISTORIAL);h.appendRow(AUDIT_HEADERS);}}
function getPedidos_(){const s=SpreadsheetApp.getActive().getSheetByName(PEDIDOS);if(s.getLastRow()<2)return[];return s.getRange(2,1,s.getLastRow()-1,HEADERS.length).getValues().filter(r=>r[0]).map(rowToPedido_);}
function crear_(b){const p=b.pedido;if(!p.nombre||!p.apellido||Number(p.importe)<=0)throw new Error('Faltan campos obligatorios.');const n=String(p.numeroOrden||'').trim();if(n&&getPedidos_().some(x=>String(x.numeroOrden).toLowerCase()===n.toLowerCase()))throw new Error('La orden #'+n+' ya existe.');const d=stamp_(),id=Utilities.getUuid();SpreadsheetApp.getActive().getSheetByName(PEDIDOS).appendRow([id,n,p.nombre,p.apellido,p.resumen||'',Number(p.importe),p.observaciones||'','PENDIENTE',b.puesto,d.fecha,d.hora,'','','','','','']);audit_(id,n,'CREACION',b.puesto,d);return{id:id};}
function actualizar_(b){const f=find_(b.id),p=b.pedido,n=String(p.numeroOrden||'').trim();if(!p.nombre||!p.apellido||Number(p.importe)<=0)throw new Error('Faltan campos obligatorios.');if(n&&getPedidos_().some(x=>x.id!==b.id&&String(x.numeroOrden).toLowerCase()===n.toLowerCase()))throw new Error('La orden #'+n+' ya existe.');const d=stamp_(),o=f.values;f.sheet.getRange(f.row,1,1,HEADERS.length).setValues([[o[0],n,p.nombre,p.apellido,p.resumen||'',Number(p.importe),p.observaciones||'',o[7],o[8],o[9],o[10],b.puesto,d.fecha,d.hora,o[14],o[15],o[16]]]);audit_(b.id,n,'EDICION',b.puesto,d);return{id:b.id};}
function cobrar_(b){const f=find_(b.id),d=stamp_();f.sheet.getRange(f.row,8).setValue('COBRADO');f.sheet.getRange(f.row,15,1,3).setValues([[b.puesto,d.fecha,d.hora]]);audit_(b.id,f.values[1],'COBRO',b.puesto,d);return{id:b.id};}
function borrarHistorial_(b){const s=SpreadsheetApp.getActive().getSheetByName(PEDIDOS);if(s.getLastRow()<2)return{eliminados:0};const e=s.getRange(2,8,s.getLastRow()-1,1).getValues();let total=0;for(let i=e.length-1;i>=0;i--)if(String(e[i][0])==='COBRADO'){s.deleteRow(i+2);total++;}audit_('','','BORRADO_HISTORIAL ('+total+')',b.puesto||'Sistema',stamp_());return{eliminados:total};}
function find_(id){const s=SpreadsheetApp.getActive().getSheetByName(PEDIDOS),v=s.getDataRange().getValues();for(let i=1;i<v.length;i++)if(String(v[i][0])===String(id))return{sheet:s,row:i+1,values:v[i]};throw new Error('Pedido no encontrado.');}
function audit_(id,o,a,u,d){SpreadsheetApp.getActive().getSheetByName(HISTORIAL).appendRow([Utilities.getUuid(),id,o,a,u,d.fecha,d.hora]);} function stamp_(){const n=new Date();return{fecha:Utilities.formatDate(n,TZ,'dd/MM/yyyy'),hora:Utilities.formatDate(n,TZ,'HH:mm')};}
function toIso_(f,h){if(!f)return'';const fd=Object.prototype.toString.call(f)==='[object Date]'?Utilities.formatDate(f,TZ,'dd/MM/yyyy'):String(f).trim();const ht=h?(Object.prototype.toString.call(h)==='[object Date]'?Utilities.formatDate(h,TZ,'HH:mm'):String(h).trim()):'00:00';const x=fd.split('/');if(x.length!==3)return String(f);return new Date(x[2]+'-'+x[1].padStart(2,'0')+'-'+x[0].padStart(2,'0')+'T'+ht+':00-03:00').toISOString();}
function rowToPedido_(r){return{id:String(r[0]),numeroOrden:String(r[1]||''),nombre:String(r[2]),apellido:String(r[3]),resumen:String(r[4]||''),importe:Number(r[5]),observaciones:String(r[6]||''),estado:String(r[7]),creadoPor:String(r[8]),creadoEn:toIso_(r[9],r[10]),modificadoPor:String(r[11]||''),modificadoEn:toIso_(r[12],r[13]),cobradoPor:String(r[14]||''),cobradoEn:toIso_(r[15],r[16])};} function json_(d){return ContentService.createTextOutput(JSON.stringify(d)).setMimeType(ContentService.MimeType.JSON);}

